{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "cms:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "cms:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "cms:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "cms:migrate": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate",
    "cms:seed": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload run scripts/cms-seed.ts",
    "cms:create-admin": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload run scripts/cms-create-admin.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "graphql": "^16.14.2",
    "next": "16.3.8",
    "nodemailer": "10.1.2",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
