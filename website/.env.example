# Kopie als .env.local (lokal) bzw. Umgebungsvariablen in Vercel/hPanel anlegen. Nie committen.

# Pflicht für das Backend (/backend): langer Zufallswert, z. B. `openssl rand -hex 32`.
# Ohne diesen Wert zeigt die Website den Standardinhalt aus src/content/ und das Backend ist aus.
PAYLOAD_SECRET=

# Speicherort der CMS-Daten (SQLite-Datei und Uploads).
# Hostinger: absoluter Pfad außerhalb des Deploy-Ordners, damit Deployments die Daten nicht überschreiben.
# Vercel: nicht setzen, dort gilt der flüchtige Ordner /tmp (nur Vorschau).
# CMS_DATA_DIR=/home/uXXXX/cms-data

# Optional: andere Datenbank, z. B. ein libSQL-Server
# DATABASE_URL=libsql://…
# DATABASE_AUTH_TOKEN=

# Woher die Seiten ihre Inhalte nehmen: "true" = CMS, "false" = Standardinhalt aus src/content/.
# Ohne Angabe: CMS, außer auf Vercel (dort flüchtiger Speicher, daher Standardinhalt).
# CMS_CONTENT=false

# Ein leeres CMS füllt sich beim ersten Start mit dem Inhalt der bisherigen Website. "false" schaltet das ab.
# CMS_SEED=false

# Nur für die Einrichtung: erlaubt das Anlegen des ersten Kontos im Browser.
# Danach wieder entfernen. Besser: `npm run cms:create-admin`.
# CMS_ALLOW_FIRST_USER=true

# Optional: erlaubte Herkunftsadressen für Anmeldungen per Cookie, kommagetrennt
# CMS_CSRF_ORIGINS=https://am-anfang-war-es-liebe.de

# E-Mail für Kursanmeldungen: Empfänger und Postfach stellt ein Admin im Backend unter „E-Mail und Anmeldungen“ ein.
# Alternativ (haben Vorrang) per Umgebungsvariable:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=anmeldung@example.org
# SMTP_PASSWORD=
# MAIL_FROM=anmeldung@example.org

# Höchstzahl Kursanmeldungen je Internetadresse und Stunde (Standard 10)
# CMS_REGISTRATION_LIMIT=10
