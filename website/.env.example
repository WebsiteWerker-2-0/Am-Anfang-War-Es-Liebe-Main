# Kopie als .env.local (lokal) bzw. Umgebungsvariablen in Vercel/hPanel anlegen. Nie committen.

# Alle Einstellungen sind optional. Ohne sie läuft das Backend sofort:
#  - Daten (Datenbank, Uploads, Geheimnis) liegen in ~/cms-data (Vercel: /tmp/cms-data, lokal in der Entwicklung: ./data)
#  - das Geheimnis zum Signieren der Anmeldungen wird beim ersten Start erzeugt (Datei .secret im Datenordner)
#  - das erste Konto legt man an, indem man im Datenordner eine leere Datei ALLOW_FIRST_USER anlegt;
#    sie wird nach dem ersten Konto automatisch entfernt

# Eigenes Geheimnis statt der erzeugten Datei, z. B. `openssl rand -hex 32`
# PAYLOAD_SECRET=

# Anderer Speicherort der CMS-Daten (SQLite-Datei und Uploads), am besten außerhalb des App-Ordners
# CMS_DATA_DIR=/home/uXXXX/cms-data

# Optional: andere Datenbank, z. B. ein libSQL-Server
# DATABASE_URL=libsql://…
# DATABASE_AUTH_TOKEN=

# Woher die Seiten ihre Inhalte nehmen: "true" = CMS, "false" = Standardinhalt aus src/content/.
# Ohne Angabe: CMS, außer auf Vercel (dort flüchtiger Speicher, daher Standardinhalt).
# CMS_CONTENT=false

# Ein leeres CMS füllt sich beim ersten Start mit dem Inhalt der bisherigen Website. "false" schaltet das ab.
# CMS_SEED=false

# Erlaubt das Anlegen des ersten Kontos im Browser (statt der Datei ALLOW_FIRST_USER).
# Danach wieder entfernen. Alternative: `npm run cms:create-admin`.
# CMS_ALLOW_FIRST_USER=true

# Optional: erlaubte Herkunftsadressen für Anmeldungen per Cookie, kommagetrennt
# CMS_CSRF_ORIGINS=https://am-anfang-war-es-liebe.de
